# Copiar como .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Base de datos de desarrollo y de pruebas (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrotech
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/agrotech_test

# Conexiones simultáneas del pool
DB_POOL_MAX=10

# Ruta de las migraciones (por defecto ../db/migrations)
# MIGRATIONS_DIR=

# Orígenes permitidos para la vista web de Expo en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:8081
