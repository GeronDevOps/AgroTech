# Copiar como .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Base de datos de desarrollo y de pruebas (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrotech
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/agrotech_test

# Conexiones simultáneas del pool
DB_POOL_MAX=10

# Ruta de las migraciones (por defecto ../db/migrations)
# MIGRATIONS_DIR=

# Autenticación (AGRO-5). Generar el secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
JWT_EXPIRA_EN=7d
# Costo de Bcrypt (12 en producción; menor solo para pruebas)
BCRYPT_COSTO=12
AVISO_PRIVACIDAD_VERSION=1.0

# Fotos de productos (AGRO-6). Driver "local" en desarrollo; "s3" en AWS (AGRO-16).
FOTOS_DRIVER=local
# FOTOS_DIR=./uploads
# Solo con FOTOS_DRIVER=s3 (credenciales: rol de la instancia EC2, nunca llaves en este archivo)
# FOTOS_S3_BUCKET=agrotech-imagenes-produccion-<cuenta>
# AWS_REGION=us-east-1
# URL pública de las fotos; vacía = se arma con el host de la petición (sirve con la IP de la LAN)
FOTOS_URL_BASE=

# Pasarela de pagos Wompi (ADR-001). Llaves del sandbox: comercios.wompi.co → Desarrolladores.
WOMPI_LLAVE_PUBLICA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=
WOMPI_AMBIENTE=test
# URL pública a la que Wompi devuelve al usuario (debe ser https en producción)
WOMPI_URL_RETORNO=
WOMPI_RETORNO_APP=agrotech://pago

# CU-13 A3: horas sin respuesta antes de cancelar un pedido pendiente
HORAS_CANCELACION=48

# Orígenes permitidos para la vista web de Expo en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:8081

# --- Notificaciones push (RF-16a · FCM HTTP v1) ---
# Ruta al JSON de la cuenta de servicio: consola de Firebase → Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada. NUNCA se sube al repositorio.
# Vacía: el push queda desactivado (no se registra nada) y los avisos solo llegan por WebSocket.
FCM_CREDENCIALES=

# --- Correo saliente (Fase 2: CU-08 código de recuperación, CU-18 y CU-20 avisos) ---
# consola (desarrollo: lo imprime en la terminal) | archivo (pruebas de sistema) | smtp (producción)
CORREO_DRIVER=consola
# CORREO_DIR=./tmp/buzon
# CORREO_SMTP_URL=smtps://usuario:clave@smtp.servidor.co:465
CORREO_REMITENTE=AgroTech <no-responder@agrotech.co>
