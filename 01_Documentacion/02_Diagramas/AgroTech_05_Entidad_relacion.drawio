ry"></mxGeometry></mxCell><mxCell id="c23" value="recibe (productor)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="tUsr" target="tPed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="envía" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=1;exitY=0.95;entryX=0.5;entryY=0;" edge="1" parent="1" source="tUsr" target="tMsg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="330"/><mxPoint x="960" y="440"/><mxPoint x="1165" y="440"/></Array></mxGeometry></mxCell><mxCell id="c25" value="tiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="tPed" target="tMsg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="contiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERoneToMany;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tPed" target="tDet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="820"/><mxPoint x="425" y="820"/></Array></mxGeometry></mxCell><mxCell id="c27" value="incluido en" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="tPto" target="tDet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="930"/></Array></mxGeometry></mxCell><mxCell id="c28" value="registra" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERoneToMany;exitX=0.65;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tPed" target="tHis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="se paga con" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=1;exitY=0.72;entryX=0;entryY=0.9;" edge="1" parent="1" source="tPed" target="tPag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="es calificado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToOne;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="tPed" target="tCal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="760"/><mxPoint x="950" y="820"/></Array></mxGeometry></mxCell><mxCell id="c31" value="cambia estado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERzeroToOne;endArrow=ERzeroToMany;exitX=0;exitY=0.85;entryX=0;entryY=0.9;" edge="1" parent="1" source="tUsr" target="tHis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="300"/><mxPoint x="510" y="1080"/><mxPoint x="620" y="1080"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Tipos ENUM:&lt;/b&gt; rol_usuario (PRODUCTOR, CONSUMIDOR, ADMINISTRADOR) · estado_cuenta · estado_producto · estado_pedido · estado_reporte · estado_token · metodo_pago · estado_pago · estado_transaccion · resultado_sync · estado_envio.&lt;br&gt;&lt;b&gt;Migraciones:&lt;/b&gt; 001 esquema inicial · 002 catálogo (CHECK de categoría y unidad) · 003 pedidos y pagos (tabla PAGO; disparador: no se acepta un pedido en línea sin pago aprobado) · 004 sincronización (OPERACION_SYNC, índices de /sync/pull) · 005 comunicación y ventas (leido_en, NOTIFICACION; disparadores: chat solo en pedidos activos y entre sus partes, calificación solo de pedidos entregados).&lt;br&gt;&lt;b&gt;Índices:&lt;/b&gt; producto(estado, municipio, categoria) · producto(actualizado_en, id_producto) · GIST(usuario.coordenadas) · pedido(id_productor, estado) · pedido(id_consumidor, estado) · mensaje(id_pedido, fecha) · notificacion(proximo_intento) parcial.&lt;br&gt;&lt;b&gt;Concurrencia y sincronización:&lt;/b&gt; version + actualizado_en en PRODUCTO y PEDIDO detectan conflictos; UQ (clave_idempotencia, id_productor) evita pedidos duplicados por reintentos en 3G; los UUID se pueden generar en el teléfono sin conexión (INSERT … ON CONFLICT (id) DO NOTHING).&lt;br&gt;&lt;b&gt;Derivados:&lt;/b&gt; el promedio del productor se obtiene de la vista v_reputacion_productor (CALIFICACION ⋈ PEDIDO); el receptor de un MENSAJE es la contraparte del pedido." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1150" width="1510" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Base local SQLite (app)" id="5fdb69757ed66990f23a"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Base local SQLite en el teléfono&lt;/b&gt; (expo-sqlite, esquema versión 2) — soporte de RF-17 / CU-17" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="26" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;cola_operaciones&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="430" height="186" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;id_operacion: TEXT (UUID)&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tipo: TEXT (CREAR / EDITAR)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;entidad: TEXT (PRODUCTO / MENSAJE / CALIFICACION)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_entidad: TEXT (UUID)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;payload: TEXT (JSON)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ruta_local_archivo: TEXT NULL (foto y miniatura)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;estado: TEXT (PENDIENTE / ENVIANDO / CON_ERROR)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;intentos: INTEGER&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;error: TEXT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;creado_en: TEXT (ISO 8601)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="q"><mxGeometry x="0" y="28" width="430" height="158" as="geometry"/></mxCell><mxCell id="cp" value="&lt;b&gt;cache_producto&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="320" height="156" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;id_producto: TEXT&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_productor · estado · municipio · categoria&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;precio · stock: REAL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fecha_publicacion: TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;datos: TEXT (JSON)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;foto_local: TEXT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;version: INTEGER&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;actualizado_en: TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="cp"><mxGeometry x="0" y="28" width="320" height="128" as="geometry"/></mxCell><mxCell id="cpe" value="&lt;b&gt;cache_pedido&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="320" height="111" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;id_pedido: TEXT&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;estado · fecha: TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;datos: TEXT (JSON)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;version: INTEGER&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;actualizado_en: TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="cpe"><mxGeometry x="0" y="28" width="320" height="83" as="geometry"/></mxCell><mxCell id="cm" value="&lt;b&gt;cache_mensaje&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="230" height="96" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;id_mensaje: TEXT&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_pedido: TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fecha: TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;datos: TEXT (JSON)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="cm"><mxGeometry x="0" y="28" width="230" height="68" as="geometry"/></mxCell><mxCell id="car" value="&lt;b&gt;carrito_local&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="210" width="230" height="81" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;id_producto: TEXT&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cantidad: REAL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;agregado_en: TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="car"><mxGeometry x="0" y="28" width="230" height="53" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;meta_sync&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="330" width="260" height="81" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;PK&lt;/b&gt;  &lt;u&gt;clave: TEXT&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;valor: TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(version_esquema, marca de /sync/pull)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="meta"><mxGeometry x="0" y="28" width="260" height="53" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Protocolo:&lt;/b&gt; 1) al recuperar la red (verificada contra GET /api/v1/salud), la app envía la cola en orden de creado_en: las publicaciones nuevas con foto a POST /api/v1/productos (idempotente por id) y el resto en lotes a POST /api/v1/sync/push; 2) por cada id_operacion el servidor responde PUBLICADO o YA_APLICADA (sale de la cola), CON_ERROR (queda con el motivo; en conflicto de versión prevalece el servidor) o REINTENTAR (vuelve a PENDIENTE); 3) la app pide GET /api/v1/sync/pull?desde=&amp;lt;marca&amp;gt; (solapamiento de 2 min, páginas de 500 productos) y actualiza cache_*; 4) guarda servidorEn como nueva marca en meta_sync. El JWT no se guarda aquí: va en el almacén seguro del sistema (Android Keystore)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="1240" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>