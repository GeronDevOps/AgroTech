 style="shape=umlFrame;whiteSpace=wrap;html=1;width=56;height=22;fontStyle=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="870" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c31" value="[APROBADO]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="532" y="871" width="560" height="20" as="geometry"/></mxCell><mxCell id="c32" value="16: aviso «pedido pagado» (WSS o push, RF-16a)" style="endArrow=open;endFill=0;endSize=10;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="626.0" y="915" as="sourcePoint"/><mxPoint x="1379.0" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="359.0" y="950" width="12" height="110" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="614.0" y="965" width="12" height="55" as="geometry"/></mxCell><mxCell id="c35" value="17: GET /api/v1/pedidos/{id}" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="371.0" y="975" as="sourcePoint"/><mxPoint x="614.0" y="975" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="18: 200 {estadoPago}" style="endArrow=open;endFill=0;endSize=8;dashed=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="614.0" y="1015" as="sourcePoint"/><mxPoint x="371.0" y="1015" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="19: muestra «Pago aprobado» o «Pago rechazado: reintente o pague contra entrega»" style="endArrow=open;endFill=0;endSize=8;dashed=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="359.0" y="1050" as="sourcePoint"/><mxPoint x="116.0" y="1050" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Seguridad (ADR-001):&lt;/b&gt; AgroTech nunca recibe datos de tarjeta (checkout alojado por Wompi); el monto y la firma se calculan en el servidor; los secretos de integridad y de eventos solo existen en el servidor; el pago se confirma únicamente con el evento firmado, nunca con la redirección. Un solo pago vigente por pedido (índice único parcial) evita cobros dobles. El productor solo puede aceptar el pedido con el pago aprobado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="1520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>