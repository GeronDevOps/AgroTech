00" y="187"/></Array></mxGeometry></mxCell><mxCell id="c34" value="reportes" style="html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;rounded=0;dashed=1;" edge="1" parent="1" source="C" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Notación DeMarco:&lt;/b&gt; rectángulo = entidad externa · óvalo = proceso · líneas paralelas = almacén · flecha = flujo · discontinuo = Fase 2 · * = almacén repetido para no cruzar el diagrama.&lt;br&gt;&lt;b&gt;Sin conexión (CU-17):&lt;/b&gt; la app guarda una copia local (SQLite) y una cola de operaciones idempotentes que reenvía a los procesos 2.0, 4.0 y 5.0 al volver la red." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="995" width="1480" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>