tex="1" parent="1"><mxGeometry x="270" y="672" width="960" height="140" as="geometry"/></mxCell><mxCell id="c24" value="[por cada productor del carrito]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="673" width="520" height="20" as="geometry"/></mxCell><mxCell id="c25" value="12: UPDATE producto SET stock = stock − cant, version = version + 1" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.0" y="716" as="sourcePoint"/><mxPoint x="753.0" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="13: INSERT pedido «Pendiente» (clave_idempotencia) + detalle + historial" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.0" y="770" as="sourcePoint"/><mxPoint x="753.0" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="14: COMMIT" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.0" y="840" as="sourcePoint"/><mxPoint x="753.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="15: 201 Created + comprobante(s)" style="endArrow=open;endFill=0;endSize=8;dashed=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="890" as="sourcePoint"/><mxPoint x="329.0" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="16: Muestra el comprobante" style="endArrow=open;end