dArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1130" as="sourcePoint"/><mxPoint x="1540" y="1130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="[bandeja de salida push: siempre que haya teléfonos registrados]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="278" y="1132" width="520" height="20" as="geometry"/></mxCell><mxCell id="c38" value="18: evento «pedido_nuevo» (todas sus sesiones)" style="endArrow=open;endFill=0;endSize=10;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="983.0" y="1080" as="sourcePoint"/><mxPoint x="1407.0" y="1080" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="535.0" y="1000" width="12" height="20" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="535.0" y="1160" width="12" height="85" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="753.0" y="1166" width="12" height="24" as="geometry"/></mxCell><mxCell id="c42" value="19: INSERT notificacion «PENDIENTE»" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.0" y="1176" as="sourcePoint"/><mxPoint x="753.0" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1189.0" y="1215" width="12" height="85" as="geometry"/></mxCell><mxCell id="c44" value="20: FCM HTTP v1 · un envío por token VIGENTE" style="endArrow=open;endFill=0;endSize=10;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.0" y="1230" as="sourcePoint"/><mxPoint x="1189.0" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="21: notificación push (al tocarla abre el pedido)" style="endArrow=open;endFill=0;endSize=10;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1201.0" y="1280" as="sourcePoint"/><mxPoint x="1407.0" y="1280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="ENVIADA · token vencido → dispositivo INVALIDO · falla temporal → reintento a 1, 2, 4 y 8 min (5 intentos, luego FALLIDA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontColor=#7a4f00;" vertex="1" parent="1"><mxGeometry x="700" y="1320" width="830" height="40" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Precondición:&lt;/b&gt; el consumidor tiene conexión; sin red, la app conserva el carrito y no permite confirmar (CU-04, A2). Toda la confirmación es atómica: o se crean todos los pedidos (uno por productor) o ninguno. Un reintento con la misma Idempotency-Key devuelve el mismo resultado sin duplicar el pedido ni descontar dos veces el stock. Si falla el aviso, el pedido se mantiene y el envío se reintenta (CU-04, A4); sin teléfonos registrados el aviso queda SIN_DISPOSITIVO y llega dentro de la app." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1430" width="1530" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>