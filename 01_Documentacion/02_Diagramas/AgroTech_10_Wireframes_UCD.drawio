ml=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="1332" y="392" width="38" height="16" as="geometry"/></mxCell><mxCell id="c84" value="" style="rounded=0;html=1;fillColor=#43a047;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1390" y="310" width="30" height="80" as="geometry"/></mxCell><mxCell id="c85" value="S2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="1386" y="392" width="38" height="16" as="geometry"/></mxCell><mxCell id="c86" value="" style="rounded=0;html=1;fillColor=#43a047;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1444" y="326" width="30" height="64" as="geometry"/></mxCell><mxCell id="c87" value="S3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="392" width="38" height="16" as="geometry"/></mxCell><mxCell id="c88" value="" style="rounded=0;html=1;fillColor=#43a047;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1498" y="286" width="30" height="104" as="geometry"/></mxCell><mxCell id="c89" value="S4" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="1494" y="392" width="38" height="16" as="geometry"/></mxCell><mxCell id="c90" value="&lt;b&gt;Más vendidos&lt;/b&gt;&lt;br&gt;1. Papa pastusa · 18 bultos&lt;br&gt;2. Cebolla junca · 40 kg&lt;br&gt;3. Mora · 12 kg" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1318" y="420" width="238" height="80" as="geometry"/></mxCell><mxCell id="c91" value="Las cifras coinciden con los pedidos entregados (CA-11)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1318" y="516" width="238" height="30" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;Principios aplicados (RNF-02):&lt;/b&gt; ícono + texto en cada acción · botones de al menos 48 dp · contraste alto (verde oscuro sobre blanco) · una tarea por pantalla · teclado numérico y selectores en lugar de texto libre · indicador permanente de conexión y fecha de última sincronización · acciones que exigen red deshabilitadas con explicación. &lt;b&gt;Validación:&lt;/b&gt; prueba con productores de la asociación el 13/10 (EDT 5.4, AGRO-17) con el protocolo docs/piloto/VALIDACION_PROTOTIPOS_UCD.md." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1540" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>