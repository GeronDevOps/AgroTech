eStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=34;" edge="1" parent="1" source="aProd" target="aUsr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCons" target="aUsr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="30"/><mxPoint x="95" y="30"/></Array></mxGeometry></mxCell><mxCell id="c23" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU-08" target="CU-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU-11" target="CU-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU-12" target="CU-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="«extend»&lt;br&gt;[elige pago en línea]" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU-22" target="CU-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Color:&lt;/b&gt; amarillo = casos de todo usuario · verde = productor · azul = consumidor · gris = extensiones y administración.&lt;br&gt;&lt;b&gt;Borde:&lt;/b&gt; continuo grueso = MVP (Fase 1) · discontinuo gris = Fase 2 (Product Backlog). La nota en naranja indica la parte del caso que entra al MVP.&lt;br&gt;Servicios de apoyo (push, pasarela de pagos Wompi, correo, geolocalización, almacenamiento de imágenes) se modelan en los diagramas de flujo, arquitectura y despliegue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200" y="1128" width="1100" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>