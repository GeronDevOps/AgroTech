{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "piloto": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.agrotech.co"
      }
    },
    "produccion": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.agrotech.co"
      }
    }
  },
  "submit": {
    "produccion": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
